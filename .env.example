@"
# Copy this file to .env and fill the values. NEVER push .env to GitHub.
GITHUB_TOKEN=
GITHUB_REPO=your-username/agentic-devops
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only needed if LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
POLL_SECONDS=30
"@ | Set-Content .env.example